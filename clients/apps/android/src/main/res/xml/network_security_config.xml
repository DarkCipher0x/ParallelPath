<?xml version="1.0" encoding="utf-8"?>
<!-- Everything is HTTPS (post-quantum TLS), except the call page, which the app's own engine serves on this device's
     loopback address to the call screen. Nothing else may ever use plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
