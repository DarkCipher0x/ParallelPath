<ui:WizardPage x:Class="PPSetup.Server.Pages.FeaturesPage"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="clr-namespace:PPSetup.Ui;assembly=PPSetup.Ui">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,8,0">
      <ui:Banner x:Name="Problem" Tone="Error" Visibility="Collapsed" Margin="0,0,0,14" />

      <CheckBox x:Name="AutoStart" Style="{StaticResource FeatureCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource H2}" Text="Start automatically with Windows" />
          <TextBlock Style="{StaticResource Small}" Text="Runs as a Windows service under its own virtual account, and restarts itself if anything goes wrong." />
        </StackPanel>
      </CheckBox>

      <CheckBox x:Name="Firewall" Style="{StaticResource FeatureCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource H2}" Text="Allow through Windows Firewall" />
          <TextBlock Style="{StaticResource Small}" Text="Lets your family's devices reach the server. The rule covers this program and its port only." />
        </StackPanel>
      </CheckBox>
      <StackPanel x:Name="FirewallScope" Margin="48,-4,0,12">
        <RadioButton x:Name="LanOnly" GroupName="scope" Content="Private and domain networks only (home or office)" Margin="0,0,0,8" />
        <RadioButton x:Name="AllNetworks" GroupName="scope" Content="All networks, including public (a VPS, or port forwarding from the internet)" />
      </StackPanel>

      <CheckBox x:Name="Calls" Style="{StaticResource FeatureCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource H2}" Text="Voice and video calls" />
          <TextBlock Style="{StaticResource Small}" Text="A built-in relay so HD calls connect from anywhere, even behind mobile networks. It only ever forwards media that's end-to-end encrypted. Opens TCP/UDP 3478 and UDP 49160-49200." />
        </StackPanel>
      </CheckBox>

      <TextBlock Style="{StaticResource Label}" Text="CERTIFICATE - SO BROWSERS TRUST THE WEB APP" Margin="0,10,0,6" />
      <StackPanel Margin="0,0,0,14">
        <RadioButton x:Name="CertLocal" GroupName="cert" Margin="0,0,0,8">
          <TextBlock TextWrapping="Wrap" Text="This server's own certificate authority (home or office network). Each device trusts it once - the server's /trust page shows how. The apps need nothing." />
        </RadioButton>
        <CheckBox x:Name="TrustCa" Margin="28,0,0,10" Content="Trust it on this PC now (browsers here then show no warning)" />
        <RadioButton x:Name="CertAcme" GroupName="cert" Margin="0,0,0,8">
          <TextBlock TextWrapping="Wrap" Text="Let's Encrypt (a server with a public domain name pointing at it; ports 80 and the server's port reachable from the internet)" />
        </RadioButton>
        <Grid x:Name="AcmeOptions" Margin="28,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,6,0">
            <TextBlock Style="{StaticResource Label}" Text="DOMAIN NAME" />
            <TextBox x:Name="AcmeDomain" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,0,0">
            <TextBlock Style="{StaticResource Label}" Text="EMAIL FOR EXPIRY NOTICES (OPTIONAL)" />
            <TextBox x:Name="AcmeEmail" />
          </StackPanel>
        </Grid>
        <RadioButton x:Name="CertFiles" GroupName="cert" Margin="0,0,0,8" Content="My own certificate files (PEM)" />
        <Grid x:Name="FileOptions" Margin="28,0,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,6,0">
            <TextBlock Style="{StaticResource Label}" Text="CERTIFICATE (FULL CHAIN)" />
            <TextBox x:Name="CertFile" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,0,0">
            <TextBlock Style="{StaticResource Label}" Text="PRIVATE KEY" />
            <TextBox x:Name="KeyFile" />
          </StackPanel>
        </Grid>
      </StackPanel>

      <CheckBox x:Name="Backups" Style="{StaticResource FeatureCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource H2}" Text="Daily backups" />
          <TextBlock Style="{StaticResource Small}" Text="Sealed copies of the database and the encrypted files - unreadable without this server's keys and the families' devices, so another drive is fine." />
        </StackPanel>
      </CheckBox>
      <Grid x:Name="BackupOptions" Margin="48,-4,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="110" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource Label}" Text="BACKUP FOLDER" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Secondary}" Content="Browse…" Margin="8,0,0,0" Click="BrowseBackups" />
            <TextBox x:Name="BackupDir" />
          </DockPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="12,0,0,0">
          <TextBlock Style="{StaticResource Label}" Text="KEEP (DAYS)" />
          <TextBox x:Name="BackupKeep" MaxLength="3" />
        </StackPanel>
      </Grid>

      <CheckBox x:Name="Tray" Style="{StaticResource FeatureCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource H2}" Text="Icon by the clock" />
          <TextBlock Style="{StaticResource Small}" Text="ParallelPath Server Manager: shows whether the server is running, and opens it with one click. Starts when you sign in." />
        </StackPanel>
      </CheckBox>

      <CheckBox x:Name="Shortcuts" Style="{StaticResource FeatureCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource H2}" Text="Start-menu shortcuts" />
          <TextBlock Style="{StaticResource Small}" Text="ParallelPath Server · Create an invite code · Server status · Uninstall - under Start › ParallelPath Server." />
        </StackPanel>
      </CheckBox>

      <CheckBox x:Name="FirstInvite" Style="{StaticResource FeatureCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource H2}" Text="Create the first invite code" />
          <TextBlock Style="{StaticResource Small}" Text="For the person who will set up your family space in the app. Works once, for 7 days." />
        </StackPanel>
      </CheckBox>

      <StackPanel x:Name="UnencryptedPanel" Visibility="Collapsed" Margin="0,8,0,0">
        <ui:Banner x:Name="EncryptionNote" Tone="Warn" Margin="0,0,0,10" />
        <CheckBox x:Name="Unencrypted" Style="{StaticResource FeatureCard}">
          <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="Allow a drive without BitLocker (testing only)" Foreground="{StaticResource Warm}" />
            <TextBlock Style="{StaticResource Small}" Text="For trying ParallelPath out. Never use a server like this for real families - turn on BitLocker instead." />
          </StackPanel>
        </CheckBox>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</ui:WizardPage>
