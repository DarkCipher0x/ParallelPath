<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ParallelPath dark theme: the same tokens as the apps and the web client (clients/core/designsystem Theme.kt). -->
  <Color x:Key="BgColor">#0B1517</Color>
  <Color x:Key="Bg2Color">#0F1D20</Color>
  <Color x:Key="PanelColor">#132427</Color>
  <Color x:Key="Panel2Color">#182D31</Color>
  <Color x:Key="LineColor">#22393D</Color>
  <Color x:Key="Line2Color">#2E4B50</Color>
  <Color x:Key="FgColor">#E8F3F2</Color>
  <Color x:Key="FgDimColor">#A8C1BF</Color>
  <Color x:Key="FgMuteColor">#7A9693</Color>
  <Color x:Key="AccentColor">#3DD6D0</Color>
  <Color x:Key="Accent2Color">#66ECE6</Color>
  <Color x:Key="AccentInkColor">#052826</Color>
  <Color x:Key="AccentSoftColor">#1F3DD6D0</Color>
  <Color x:Key="WarmColor">#F2A65A</Color>
  <Color x:Key="OkColor">#5FD38D</Color>
  <Color x:Key="WarnColor">#F2C14E</Color>
  <Color x:Key="DangerColor">#FF7A7A</Color>

  <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
  <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="Panel2" Color="{StaticResource Panel2Color}" />
  <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="Line2" Color="{StaticResource Line2Color}" />
  <SolidColorBrush x:Key="Fg" Color="{StaticResource FgColor}" />
  <SolidColorBrush x:Key="FgDim" Color="{StaticResource FgDimColor}" />
  <SolidColorBrush x:Key="FgMute" Color="{StaticResource FgMuteColor}" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="Accent2" Color="{StaticResource Accent2Color}" />
  <SolidColorBrush x:Key="AccentInk" Color="{StaticResource AccentInkColor}" />
  <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="Warm" Color="{StaticResource WarmColor}" />
  <SolidColorBrush x:Key="WarmSoft" Color="#1FF2A65A" />
  <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}" />
  <SolidColorBrush x:Key="OkSoft" Color="#1F5FD38D" />
  <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
  <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerSoft" Color="#1FFF7A7A" />

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
  <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">12</CornerRadius>

  <!-- Text -->
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Fg}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Fg}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource FgDim}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="21" />
  </Style>
  <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource FgMute}" />
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource FgMute}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style x:Key="Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{StaticResource Fg}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Surfaces -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
    <Setter Property="Padding" Value="18,16" />
  </Style>

  <!-- Buttons -->
  <Style x:Key="ButtonBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusSmall}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent2}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="b" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Accent2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent2}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
    <Setter Property="Foreground" Value="{StaticResource Fg}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Panel2}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource FgDim}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="12,10" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource Quiet}">
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Accent2}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Text boxes -->
  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource Fg}" />
    <Setter Property="Background" Value="{StaticResource Bg2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
    <Setter Property="SelectionOpacity" Value="0.35" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusSmall}" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter Property="Background" Value="{StaticResource Panel}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="b" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A tick box drawn the ParallelPath way -->
  <ControlTemplate x:Key="TickBox" TargetType="CheckBox">
    <Grid Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="box" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5" BorderBrush="{StaticResource Line2}"
              Background="{StaticResource Bg2}" VerticalAlignment="Top" Margin="0,1,12,0">
        <Path x:Name="tick" Data="M 4.5,10 L 8.5,14 L 15.5,6" Stroke="{StaticResource AccentInk}" StrokeThickness="2.2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
      </Border>
      <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}" />
        <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter TargetName="tick" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent2}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Fg}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource TickBox}" />
  </Style>

  <!-- A feature card: a whole panel that ticks on and off -->
  <Style x:Key="FeatureCard" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Fg}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="card" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusLarge}" Padding="16,14">
            <CheckBox IsChecked="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False"
                      IsHitTestVisible="False" Content="{TemplateBinding Content}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="card" Property="BorderBrush" Value="#803DD6D0" />
              <Setter TargetName="card" Property="Background" Value="{StaticResource Panel2}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent2}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Fg}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="18" Height="18" Margin="0,0,10,0">
              <Ellipse x:Name="ring" Stroke="{StaticResource Line2}" StrokeThickness="1.5" Fill="{StaticResource Bg2}" />
              <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource Accent}" Visibility="Collapsed" />
            </Grid>
            <ContentPresenter VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Accent}" />
              <Setter TargetName="dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Thin, quiet scroll bars -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="4" Background="{StaticResource Line2}" Margin="1,2" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="0" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource Panel2}" />
    <Setter Property="Foreground" Value="{StaticResource Fg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
  </Style>

</ResourceDictionary>
